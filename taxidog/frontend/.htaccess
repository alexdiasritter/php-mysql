# As páginas daqui abrem normalmente pelo navegador.
# Só o layout comum fica fora do alcance — não é página, é pedaço de página.
<FilesMatch "^(header|footer)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
